# Copy this file to .env.local and fill in the values.
# On Vercel, add the same variables under Project → Settings → Environment Variables.

# Sanity (the defaults below match this project)
NEXT_PUBLIC_SANITY_PROJECT_ID=8v8936ib
NEXT_PUBLIC_SANITY_DATASET=production

# The live address of the site, without a trailing slash
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form (free Resend account: resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional. Needs a domain verified in Resend; otherwise leave blank.
CONTACT_FROM_EMAIL=

# Development only: set to 1 to fill every page with sample content
MOCK_CONTENT=
